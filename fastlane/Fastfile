require 'base64'
require 'openssl'

default_platform(:ios)

# Fix PEM content that has had its newlines stripped.
# OpenSSL requires newlines after the header, between body lines (every 64 chars),
# and before the footer. Without them it produces a misleading "invalid curve name" error.
# https://github.com/fastlane/fastlane/issues/20593
def normalize_pem(content)
  return content if content.include?("\n")
  return content unless content.include?("-----BEGIN")

  if content =~ /^(-----BEGIN [^-]+-----)(.*)(-----END [^-]+-----)$/
    header = $1
    body = $2
    footer = $3
    "#{header}\n#{body.scan(/.{1,64}/).join("\n")}\n#{footer}\n"
  else
    content
  end
end

# Monkey-patch: EC.new uses deprecated PEM_read_bio_ECPrivateKey which may fail
# with "invalid curve name" on certain OpenSSL 3.4.x builds. Fall back to
# PKey.read which uses the generic EVP interface (PEM_read_bio_PrivateKey).
# https://github.com/fastlane/fastlane/issues/20553
module OpenSSL
  module PKey
    class EC
      class << self
        unless method_defined?(:_original_new_for_curve_fix)
          alias_method :_original_new_for_curve_fix, :new
          def new(*args, &block)
            _original_new_for_curve_fix(*args, &block)
          rescue OpenSSL::PKey::ECError => e
            if args.length == 1 && args[0].is_a?(String) && e.message.include?('invalid curve name')
              puts "[FASTFILE PATCH] EC.new failed: #{e.message}, retrying with PKey.read..."
              OpenSSL::PKey.read(args[0])
            else
              raise
            end
          end
        end
      end
    end
  end
end

platform :ios do

  desc "Load ASC API Key information to use in subsequent lanes"
  lane :load_asc_api_key do
    raw = Base64.decode64(ENV["ASC_KEY_CONTENT"])
    fixed = normalize_pem(raw)
    key_b64 = Base64.strict_encode64(fixed)

    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: key_b64,
      is_key_content_base64: true
    )
  end

  desc "Sync in-app purchase & subscription localizations on ASC from fastlane/iap_localizations.json"
  lane :sync_iap do
    load_asc_api_key
    token = Spaceship::ConnectAPI::Token.create(
      **lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
    )
    require_relative "iap_sync"
    IapSync.run(token.text)
  end

  desc "Build and upload to App Store Connect"
  desc "Options:"
  desc "  overwrite_screenshots — when true (default) delete ALL screenshots on"
  desc "    ASC and re-upload fastlane/screenshots/; when false, leave ASC"
  desc "    screenshots untouched (skip them entirely). e.g."
  desc "    fastlane release overwrite_screenshots:false"
  lane :release do |options|
    # Coerce to a real boolean: CLI args and GitHub workflow_dispatch inputs
    # both arrive as the strings "true"/"false", and "false" is truthy in Ruby.
    overwrite_screenshots = options.fetch(:overwrite_screenshots, true).to_s.downcase != "false"
    load_asc_api_key
    setup_ci
    # Register the watch app's App ID on the developer portal if it doesn't
    # exist yet (idempotent). No App Store Connect record is needed — the watch
    # app ships embedded in the iOS app. Done via Spaceship directly because
    # `produce` only supports Apple ID password auth, which can't run in CI.
    watch_bundle_id = "com.blackfireapps.remotecamera.watchkitapp"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      **lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
    )
    watch_app_id_exists = Spaceship::ConnectAPI::BundleId
      .all(filter: { identifier: watch_bundle_id })
      .any? { |b| b.identifier == watch_bundle_id }
    unless watch_app_id_exists
      UI.message("Registering App ID #{watch_bundle_id}")
      Spaceship::ConnectAPI::BundleId.create(
        name: "Remote Shutter Watch",
        identifier: watch_bundle_id,
        platform: "IOS"
      )
    end
    # readonly: false so the watch app's appstore profile is generated on first
    # run if the match repo doesn't have it yet (the App ID must already exist).
    match(
      type: "appstore",
      app_identifier: [
        "com.blackfireapps.remotecamera",
        "com.blackfireapps.remotecamera.watchkitapp"
      ],
      git_url: ENV["MATCH_GIT_URL"],
      readonly: false
    )
    # Per-target manual signing: a single global PROVISIONING_PROFILE_SPECIFIER
    # xcarg can't sign both the iOS app and the embedded watch app.
    update_code_signing_settings(
      path: "RemoteShutter.xcodeproj",
      targets: ["RemoteShutter"],
      use_automatic_signing: false,
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore com.blackfireapps.remotecamera"
    )
    update_code_signing_settings(
      path: "RemoteShutter.xcodeproj",
      targets: ["RemoteShutterWatch"],
      use_automatic_signing: false,
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore com.blackfireapps.remotecamera.watchkitapp"
    )
    build_app(
      workspace: "RemoteShutter.xcworkspace",
      scheme: "RemoteCam",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "RemoteShutter.ipa",
      export_options: {
        provisioningProfiles: {
          "com.blackfireapps.remotecamera" => "match AppStore com.blackfireapps.remotecamera",
          "com.blackfireapps.remotecamera.watchkitapp" => "match AppStore com.blackfireapps.remotecamera.watchkitapp"
        }
      }
    )
    upload_to_app_store(
      skip_metadata: false,
      # When overwrite_screenshots is false, don't touch ASC screenshots at all.
      skip_screenshots: !overwrite_screenshots,
      # Delete ALL screenshots on App Store Connect before uploading, so ASC
      # exactly mirrors fastlane/screenshots/ (otherwise deliver only appends).
      overwrite_screenshots: overwrite_screenshots,
      # Alternative — upload only changed screenshots — but it is a fastlane
      # BETA that needs FASTLANE_ENABLE_BETA_DELIVER_SYNC_SCREENSHOTS=1 and has
      # flaked on ASC processing; mutually exclusive with overwrite_screenshots:
      # sync_screenshots: true,
      precheck_include_in_app_purchases: false,
      force: true,
      submit_for_review: false
    )
  end

  desc "Build the Mac Catalyst app and upload to App Store Connect (macOS platform)"
  lane :release_mac do
    load_asc_api_key
    setup_ci
    # Catalyst distribution signs with a Mac Catalyst provisioning profile
    # against the same bundle ID (universal purchase — one ASC app record).
    # readonly: false mints the catalyst certs/profile into the match repo on
    # the first run. The watch app is NOT part of the Catalyst build (its
    # embed phase is platform-filtered to iOS).
    match(
      type: "appstore",
      platform: "catalyst",
      app_identifier: ["com.blackfireapps.remotecamera"],
      git_url: ENV["MATCH_GIT_URL"],
      # Mac App Store apps ship as a .pkg signed with the SEPARATE Mac
      # Installer Distribution certificate — match doesn't fetch it unless
      # asked, and export dies with 'No signing certificate "Mac Installer
      # Distribution" found' (run 29181889025).
      additional_cert_types: ["mac_installer_distribution"],
      readonly: false
    )
    update_code_signing_settings(
      path: "RemoteShutter.xcodeproj",
      targets: ["RemoteShutter"],
      use_automatic_signing: false,
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore com.blackfireapps.remotecamera catalyst"
    )
    build_app(
      workspace: "RemoteShutter.xcworkspace",
      scheme: "RemoteCam",
      # catalyst_platform alone does NOT pick the archive destination — gym
      # archives for native macOS (no UIKit) and dependency scanning fails
      # with "Unable to find module dependency: 'UIKit'" (run 29180954433).
      # The Catalyst variant must be requested explicitly, same as ios-ci.yml.
      destination: "generic/platform=macOS,variant=Mac Catalyst",
      catalyst_platform: "macos",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      export_options: {
        provisioningProfiles: {
          "com.blackfireapps.remotecamera" => "match AppStore com.blackfireapps.remotecamera catalyst"
        }
      }
    )
    upload_to_app_store(
      platform: "osx",
      skip_metadata: false,
      skip_screenshots: false,
      # Mac screenshots live in their own tree: deliver uploads files in
      # screenshots_path to the run's platform, and APP_DESKTOP display types
      # are invalid on the iOS version (run 29181223484) — and vice versa.
      screenshots_path: "./fastlane/screenshots_mac",
      # Delete ALL Mac screenshots on ASC before uploading (mirror the local set).
      overwrite_screenshots: true,
      # Beta alternative (upload only changed) — needs
      # FASTLANE_ENABLE_BETA_DELIVER_SYNC_SCREENSHOTS=1, mutually exclusive:
      # sync_screenshots: true,
      precheck_include_in_app_purchases: false,
      force: true,
      submit_for_review: false
    )
  end
end
