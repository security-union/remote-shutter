default_platform(:ios)

platform :ios do

  desc "Sync certificates and profiles via fastlane match"
  lane :sync_signing do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match(
      type: "appstore",
      app_identifier: "com.blackfireapps.remotecamera",
      git_url: ENV["MATCH_GIT_URL"],
      readonly: true
    )
  end

  desc "Build the app for App Store distribution"
  lane :build_release do
    sync_signing

    build_app(
      workspace: "RemoteShutter.xcworkspace",
      scheme: "RemoteCam",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "RemoteShutter.ipa"
    )
  end

  desc "Build and upload to App Store Connect"
  lane :release do
    build_release

    upload_to_app_store(
      skip_metadata: false,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      force: true,
      submit_for_review: false
    )
  end
end
