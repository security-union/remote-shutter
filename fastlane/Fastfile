require 'base64'

default_platform(:ios)

# Fix PEM content that has had its newlines stripped.
# OpenSSL requires newlines after the header, between body lines (every 64 chars),
# and before the footer. Without them it produces a misleading "invalid curve name" error.
# https://github.com/fastlane/fastlane/issues/20593
def normalize_pem(content)
  return content if content.include?("\n")
  return content unless content.include?("-----BEGIN")

  if content =~ /^(-----BEGIN [^-]+-----)(.*)(-----END [^-]+-----)$/
    header = $1
    body = $2
    footer = $3
    "#{header}\n#{body.scan(/.{1,64}/).join("\n")}\n#{footer}\n"
  else
    content
  end
end

platform :ios do

  desc "Sync certificates and profiles via fastlane match"
  lane :sync_signing do
    # Decode, normalize newlines, re-encode so fastlane gets valid PEM
    raw = Base64.decode64(ENV["ASC_KEY_CONTENT"])
    fixed = normalize_pem(raw)
    key_b64 = Base64.strict_encode64(fixed)

    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: key_b64,
      is_key_content_base64: true
    )

    match(
      type: "appstore",
      app_identifier: "com.blackfireapps.remotecamera",
      git_url: ENV["MATCH_GIT_URL"],
      readonly: true
    )
  end

  desc "Build the app for App Store distribution"
  lane :build_release do
    sync_signing

    build_app(
      workspace: "RemoteShutter.xcworkspace",
      scheme: "RemoteCam",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "RemoteShutter.ipa"
    )
  end

  desc "Build and upload to App Store Connect"
  lane :release do
    build_release

    upload_to_app_store(
      skip_metadata: false,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      force: true,
      submit_for_review: false
    )
  end
end
