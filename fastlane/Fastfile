require 'base64'
require 'openssl'

default_platform(:ios)

# Fix PEM content that has had its newlines stripped.
# OpenSSL requires newlines after the header, between body lines (every 64 chars),
# and before the footer. Without them it produces a misleading "invalid curve name" error.
# https://github.com/fastlane/fastlane/issues/20593
def normalize_pem(content)
  return content if content.include?("\n")
  return content unless content.include?("-----BEGIN")

  if content =~ /^(-----BEGIN [^-]+-----)(.*)(-----END [^-]+-----)$/
    header = $1
    body = $2
    footer = $3
    "#{header}\n#{body.scan(/.{1,64}/).join("\n")}\n#{footer}\n"
  else
    content
  end
end

# Monkey-patch: EC.new uses deprecated PEM_read_bio_ECPrivateKey which may fail
# with "invalid curve name" on certain OpenSSL 3.4.x builds. Fall back to
# PKey.read which uses the generic EVP interface (PEM_read_bio_PrivateKey).
# https://github.com/fastlane/fastlane/issues/20553
module OpenSSL
  module PKey
    class EC
      class << self
        unless method_defined?(:_original_new_for_curve_fix)
          alias_method :_original_new_for_curve_fix, :new
          def new(*args, &block)
            _original_new_for_curve_fix(*args, &block)
          rescue OpenSSL::PKey::ECError => e
            if args.length == 1 && args[0].is_a?(String) && e.message.include?('invalid curve name')
              puts "[FASTFILE PATCH] EC.new failed: #{e.message}, retrying with PKey.read..."
              OpenSSL::PKey.read(args[0])
            else
              raise
            end
          end
        end
      end
    end
  end
end

platform :ios do

  desc "Load ASC API Key information to use in subsequent lanes"
  lane :load_asc_api_key do
    raw = Base64.decode64(ENV["ASC_KEY_CONTENT"])
    fixed = normalize_pem(raw)
    key_b64 = Base64.strict_encode64(fixed)

    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: key_b64,
      is_key_content_base64: true
    )
  end

  desc "Build and upload to App Store Connect"
  lane :release do
    load_asc_api_key
    setup_ci
    match(
      type: "appstore",
      app_identifier: "com.blackfireapps.remotecamera",
      git_url: ENV["MATCH_GIT_URL"],
      readonly: true
    )
    build_app(
      workspace: "RemoteShutter.xcworkspace",
      scheme: "RemoteCam",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "RemoteShutter.ipa",
      xcargs: "CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER='match AppStore com.blackfireapps.remotecamera' CODE_SIGN_IDENTITY='Apple Distribution'"
    )
    upload_to_app_store(
      skip_metadata: false,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      force: true,
      submit_for_review: false
    )
  end
end
