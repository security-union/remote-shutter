# Workaround for "invalid curve name" error on macOS 15 runners with OpenSSL 3.4+.
# Apple's .p8 keys embed the curve name "prime256v1" which newer OpenSSL rejects
# in EC.new but handles fine via the generic PKey.read parser.
# https://github.com/fastlane/fastlane/issues/20553
require 'openssl'
module OpenSSL
  module PKey
    class EC
      class << self
        unless method_defined?(:_original_new_for_curve_fix)
          alias_method :_original_new_for_curve_fix, :new
          def new(*args, &block)
            _original_new_for_curve_fix(*args, &block)
          rescue OpenSSL::PKey::ECError => e
            raise unless args.length == 1 && args[0].is_a?(String) && e.message.include?('invalid curve name')
            OpenSSL::PKey.read(args[0])
          end
        end
      end
    end
  end
end

default_platform(:ios)

platform :ios do

  desc "Sync certificates and profiles via fastlane match"
  lane :sync_signing do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match(
      type: "appstore",
      app_identifier: "com.blackfireapps.remotecamera",
      git_url: ENV["MATCH_GIT_URL"],
      readonly: true
    )
  end

  desc "Build the app for App Store distribution"
  lane :build_release do
    sync_signing

    build_app(
      workspace: "RemoteShutter.xcworkspace",
      scheme: "RemoteCam",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "RemoteShutter.ipa"
    )
  end

  desc "Build and upload to App Store Connect"
  lane :release do
    build_release

    upload_to_app_store(
      skip_metadata: false,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      force: true,
      submit_for_review: false
    )
  end
end
