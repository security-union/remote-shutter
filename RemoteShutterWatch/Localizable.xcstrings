        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneで「Watchリモート」をタップ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone에서 ‘Watch 리모컨’을 탭하세요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
