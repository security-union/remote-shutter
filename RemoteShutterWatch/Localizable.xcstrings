{
  "sourceLanguage": "en",
  "strings": {
    "On your iPhone, tap “Watch Remote”": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på “Watch-fjernbetjening” på din iPhone"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf deinem iPhone auf „Watch-Fernbedienung“"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu iPhone, toca “Control por Watch”"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur votre iPhone, touchez « Télécommande Watch »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sull’iPhone, tocca “Telecomando Watch”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneで「Watchリモート」をタップ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 ‘Watch 리모컨’을 탭하세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No seu iPhone, toque em “Controle pelo Watch”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上轻点“手表遥控”"
          }
        }
      }
    },
    "Reopen Remote Shutter on your iPhone to keep shooting": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genåbn Remote Shutter på din iPhone for at fortsætte"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Remote Shutter auf deinem iPhone erneut, um weiter aufzunehmen"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a abrir Remote Shutter en tu iPhone para seguir capturando"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouvrez Remote Shutter sur votre iPhone pour continuer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riapri Remote Shutter sull’iPhone per continuare a scattare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影を続けるにはiPhoneでRemote Shutterを再度開いてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속 촬영하려면 iPhone에서 Remote Shutter를 다시 여세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reabra o Remote Shutter no seu iPhone para continuar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上重新打开 Remote Shutter 以继续拍摄"
          }
        }
      }
    },
    "Found your iPhone. Getting ready…": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fandt din iPhone. Gør klar…"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone gefunden. Wird vorbereitet…"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone encontrado. Preparando…"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone trouvé. Préparation…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone trovato. Preparazione…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneが見つかりました。準備中…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone을 찾았습니다. 준비 중…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone encontrado. Preparando…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已找到 iPhone。正在准备…"
          }
        }
      }
    },
    "Can’t reach your iPhone": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke nå din iPhone"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone nicht erreichbar"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar con tu iPhone"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre votre iPhone"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone non raggiungibile"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneに接続できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에 연결할 수 없습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alcançar seu iPhone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到 iPhone"
          }
        }
      }
    },
    "Open Remote Shutter on your iPhone and choose “Watch Remote”": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Remote Shutter på din iPhone, og vælg “Watch-fjernbetjening”"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Remote Shutter auf deinem iPhone und wähle „Watch-Fernbedienung“"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Remote Shutter en tu iPhone y elige “Control por Watch”"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Remote Shutter sur votre iPhone et choisissez « Télécommande Watch »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Remote Shutter sull’iPhone e scegli “Telecomando Watch”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneでRemote Shutterを開き、「Watchリモート」を選択"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 Remote Shutter를 열고 ‘Watch 리모컨’을 선택하세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Remote Shutter no seu iPhone e escolha “Controle pelo Watch”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上打开 Remote Shutter 并选择“手表遥控”"
          }
        }
      }
    },
