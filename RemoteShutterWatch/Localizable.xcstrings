        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 Remote Shutter를 열고 ‘Watch 리모컨’을 선택하세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Remote Shutter pada iPhone anda dan pilih “Kawalan Jauh Watch”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Remote Shutter no seu iPhone e escolha “Controle pelo Watch”"
