          "stringUnit": {
            "state": "translated",
            "value": "Pada iPhone anda, ketik “Kawalan Jauh Watch”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No seu iPhone, toque em “Controle pelo Watch”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На iPhone нажмите «Пульт на Watch»"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'unuzda “Watch Kumandası”na dokunun"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên iPhone, chạm “Điều khiển Watch”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上轻点“手表遥控”"
          }
        }
      }
    },
    "Open Remote Shutter on your iPhone and choose “Watch Remote”": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Remote Shutter på din iPhone, og vælg “Watch-fjernbetjening”"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
