// FlatBufferSchemas.fbs
// FlatBuffers schema for Remote Shutter P2P communication
// Compile with: flatc --swift FlatBufferSchemas.fbs

file_identifier "RCAM";

namespace RemoteShutter;

// MARK: - Enums

enum CommandAction : byte {
    TakePicture = 0,
    ToggleTorch = 1,
    ToggleFlash = 2,
    ToggleCamera = 3,
    SetZoom = 4,
    SwitchLens = 5,
    StartRecording = 6,
    StopRecording = 7,
    RequestCapabilities = 8,
    SetTorchMode = 9,
    SetFlashMode = 10,
    RequestFrame = 11,
    PeerBecameCamera = 12,
    PeerBecameMonitor = 13,
    SetVideoQuality = 14,
    SetPhotoQuality = 15,
    TimerCountdown = 16,
    SyncMonitorSettings = 17,
    SetAspectRatio = 18,
    SelectCameraDevice = 19    // never sent to peers that did not advertise
                               // camera_devices — old decoders read unknown
                               // actions as TakePicture (the field default)
}

enum CameraPosition : byte {
    Back = 0,
    Front = 1
}

enum TorchMode : byte {
    Off = 0,
    On = 1,
    Auto = 2
}

enum FlashMode : byte {
    Off = 0,
    On = 1,
    Auto = 2
}

enum CameraLensType : byte {
    WideAngle = 0,
    UltraWide = 1,
    Telephoto = 2,
    DualCamera = 3
}

enum MessageType : byte {
    CameraCommand = 0,
    CameraStateResponse = 1,
    FrameData = 2
}

// New enums for quality controls (Unknown = 0 per project convention)

enum VideoResolution : byte {
    Unknown = 0,
    HD1080p = 1,
    UHD4K = 2
}

enum VideoFrameRate : byte {
    Unknown = 0,
    FPS24 = 1,
    FPS30 = 2,
    FPS60 = 3
}

enum PhotoFormat : byte {
    Unknown = 0,
    JPEG = 1,
    HEIF = 2
}

enum HDRMode : byte {
    Unknown = 0,
    Off = 1,
    On = 2
}

enum RecordingModeEnum : byte {
    Unknown = 0,
    Photo = 1,
    Video = 2,
    Shorts = 3
}

enum AspectRatioEnum : byte {
    Unknown = 0,
    FourThree = 1,
    SixteenNine = 2,
    OneOne = 3
}

// Payload format of FrameData.image_data. Unknown = legacy peer that predates
// this field — treat as JPEG. HEVC is reserved for the video-codec follow-up.
// VP9 is a stateful video stream (videocall-codecs): keyframe first, then
// inter frames in order — currently used on the Watch preview channel.
enum StreamCodec : byte {
    Unknown = 0,
    JPEG = 1,
    HEVC = 2,
    HEIC = 3,
    VP9 = 4
}

// MARK: - Command Parameters

table CommandParameters {
    send_to_remote: bool;
    zoom_factor: double;
    lens_type: CameraLensType;
    torch_mode: TorchMode;
    flash_mode: FlashMode;
    bundle_version: int;
    short_version: string;
    platform: string;
    video_resolution: VideoResolution;
    video_frame_rate: VideoFrameRate;
    photo_format: PhotoFormat;
    hdr_mode: HDRMode;
    countdown_value: int;
    recording_mode: RecordingModeEnum;
    aspect_ratio: AspectRatioEnum;
    // Appended fields only below this line (FlatBuffers schema evolution).
    device_unique_id: string;        // payload for SelectCameraDevice
}

// MARK: - Command Structure

table CameraCommand {
    action: CommandAction;
    parameters: CommandParameters;
}

// MARK: - State Structures

table ZoomRange {
    min_zoom: double;
    max_zoom: double;
}

table ZoomCapability {
    lens_type: CameraLensType;
    zoom_range: ZoomRange;
}

table ResolutionFrameRates {
    resolution: VideoResolution;
    supported_frame_rates: [VideoFrameRate];
}

table VideoQualityCapabilities {
    supported_resolutions: [VideoResolution];
    supported_frame_rates: [VideoFrameRate];
    resolution_frame_rates: [ResolutionFrameRates];
}

table PhotoQualityCapabilities {
    supports_heif: bool;
    supports_hdr: bool;
}

table CameraInfo {
    available_lenses: [CameraLensType];
    has_flash: bool;
    has_torch: bool;
    zoom_capabilities: [ZoomCapability];
    video_quality: VideoQualityCapabilities;
    photo_quality: PhotoQualityCapabilities;
    zoom_stops: [double];
    wide_angle_zoom_factor: double;
}

// One selectable physical camera on the camera peer. `position` is Back when
// the device has no front/back identity (Mac external/Continuity/Desk View
// cameras); has_unspecified_position disambiguates for peers that understand
// device selection.
table CameraDeviceInfo {
    unique_id: string;
    localized_name: string;
    position: CameraPosition;
    has_unspecified_position: bool;
    is_active: bool;
    info: CameraInfo;
    // Appended fields only below this line (FlatBuffers schema evolution).
    // Connected but delivering no frames (Mac clamshell built-in camera):
    // shown grayed out in pickers, excluded from selection.
    is_suspended: bool;
}

table CameraState {
    current_camera: CameraPosition;
    current_lens: CameraLensType;
    zoom_factor: double;
    torch_mode: TorchMode;
    flash_mode: FlashMode;
    video_resolution: VideoResolution;
    video_frame_rate: VideoFrameRate;
    photo_format: PhotoFormat;
    hdr_mode: HDRMode;
    aspect_ratio: AspectRatioEnum;
    // Appended fields only below this line (FlatBuffers schema evolution).
    active_device_id: string;
}

table CameraCapabilities {
    front_camera: CameraInfo;
    back_camera: CameraInfo;
    // Appended fields only below this line (FlatBuffers schema evolution).
    // Empty/absent = peer predates camera-device selection; a monitor must
    // not send SelectCameraDevice to such a peer.
    camera_devices: [CameraDeviceInfo];
    active_device_id: string;
}

// MARK: - Response Structure

table CameraStateResponse {
    action: CommandAction;
    success: bool;
    error: string;
    current_state: CameraState;
    capabilities: CameraCapabilities;
    media_data: [ubyte];
    recording_start_time: uint64;
    available_lenses: [CameraLensType];
    zoom_range: ZoomRange;
    current_zoom: double;
}

// MARK: - Frame Data

table FrameData {
    image_data: [ubyte];
    fps: int;
    camera_position: CameraPosition;
    orientation: int;
    // Appended fields only below this line (FlatBuffers schema evolution).
    codec: StreamCodec;              // absent/Unknown => JPEG (legacy sender)
    sequence_number: uint32;         // per-stream monotonic; gaps are logged on the monitor
}

// MARK: - P2P Message Envelope

table P2PMessage {
    type: MessageType;
    command: CameraCommand;
    response: CameraStateResponse;
    frame_data: FrameData;
}

root_type P2PMessage;

// MARK: - Watch Communication

enum WatchCommandAction : byte {
    Unknown = 0,
    SetZoom = 1,
    TakePicture = 2,
    StartRecording = 3,
    StopRecording = 4,
    SwitchLens = 5,
    ToggleFlash = 6,
    ToggleTorch = 7,
    ToggleCamera = 8,
    RequestState = 9,
    SetMode = 10,
    CancelTimer = 11,
    RequestPreviewFrame = 12
}

table WatchCommand {
    action: WatchCommandAction;
    zoom_factor: double;
    lens_type: CameraLensType;
    timer_seconds: int;
    // Appended fields only below this line (FlatBuffers schema evolution).
    mode: RecordingModeEnum;         // payload for SetMode
}

// Why the phone can or can't capture right now. Unknown = no signal yet —
// the Watch treats it as "connecting", never as ready.
enum WatchReadiness : byte {
    Unknown = 0,
    Ready = 1,
    PhoneBackgrounded = 2,   // app backgrounded / device locked — camera can't run
    NotInWatchMode = 3       // phone left the Watch Remote screen
}

// One-shot capture events, piggybacked on a state push. Unknown = no event.
enum WatchEventType : byte {
    Unknown = 0,
    PhotoTaken = 1,
    PhotoError = 2,
    RecordingStarted = 3,
    RecordingStopped = 4,
    RecordingFailed = 5,
    MicrophoneDenied = 6,
    Busy = 7,
    BusyRecording = 8,
    SendFailed = 9           // Watch-local (command never reached the phone); not sent on the wire
}

// Retyped 2026-07-01 (pre-release, no wire compatibility to keep): the old
// last_event string smuggled events, countdown ticks, and readiness reasons
// through one field. Each concept now has its own typed field.
table WatchCameraState {
    readiness: WatchReadiness;
    event: WatchEventType;
    countdown_remaining_secs: int;   // > 0 = live self-timer; authoritative in every snapshot
    current_zoom_factor: double;
    min_zoom_factor: double;
    max_zoom_factor: double;
    is_recording: bool;
    current_mode: RecordingModeEnum;
    current_lens_type: CameraLensType;
    available_lens_types: [CameraLensType];
    flash_mode: FlashMode;
    is_torch_enabled: bool;
    zoom_stops: [double];
    wide_angle_zoom_factor: double;
    state_epoch_ms: uint64;          // ordering between live messages and applicationContext
}

// Transport-level acknowledgment for a Watch command: confirms the iPhone
// decoded the command and dispatched it to the camera state machine.
// Capture *completion* still arrives separately as a state push event.
enum WatchAckStatus : byte {
    Unknown = 0,
    Ok = 1,
    NotInWatchMode = 2,
    Busy = 3,
    Failed = 4
}

table WatchCommandAck {
    status: WatchAckStatus;
    action: WatchCommandAction;      // echo of the command being acked
    detail: string;
}

// Low-res, heavily-compressed live preview frame streamed iPhone -> Watch so the
// user can frame the shot. Separate from the full-quality capture pipeline.
table WatchPreviewFrame {
    jpeg: [ubyte];        // payload bytes. Stills (HEIC/JPEG): UIImage(data:) sniffs the
                          // container. VP9: one compressed frame of a stateful stream.
    epoch_ms: uint64;     // ordering, mirrors WatchCameraState.state_epoch_ms
    // Appended fields only below this line (FlatBuffers schema evolution).
    codec: StreamCodec;   // absent/Unknown => legacy still image (sniff via UIImage)
}

// Renumbered pre-release so Unknown = 0 (project convention for all enums).
enum WatchMessageType : byte {
    Unknown = 0,
    WatchCommandMsg = 1,
    WatchStateMsg = 2,
    WatchCommandAckMsg = 3,
    WatchPreviewFrameMsg = 4
}

table WatchMessage {
    type: WatchMessageType;
    command: WatchCommand;
    state: WatchCameraState;
    ack: WatchCommandAck;
    // Appended field only below this line (FlatBuffers schema evolution).
    preview_frame: WatchPreviewFrame;
}

